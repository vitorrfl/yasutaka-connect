rules_version = '2';

// ATENÇÃO — segurança:
// Este app usa o SDK cliente do Firestore SEM autenticação (config em
// NEXT_PUBLIC_*), então NÃO dá para restringir por usuário. Estas regras
// liberam leitura/escrita para o app funcionar como ferramenta interna.
// Se um dia o app for exposto publicamente, adicione Firebase Auth e troque
// `if true` por `if request.auth != null` (ou regras por coleção/papel).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
